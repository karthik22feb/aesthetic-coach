APP_NAME="Aesthetic Coach"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8, per docs/adr/0003-mysql8-for-database.md
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=aesthetic_coach
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis-backed queues: default, ai-heavy, notifications
# (see docs/07-backend-architecture.md, section 4 Queues)
QUEUE_CONNECTION=redis

# Redis-backed cache (hot data: exercise library, profile summary, DFS-of-the-day)
# (see docs/03-system-architecture.md, section 7 Scalability Strategy)
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@aestheticcoach.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT signing (RS256) -- see docs/adr/0005-jwt-refresh-token-auth.md
# Empty here: falls back to storage/app/jwt/{private,public}.pem for local dev.
# Production: inject PEM content directly via the managed secret store.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# CORS -- comma-separated exact origins, never a wildcard in production.
# Empty by default: no browser-based client exists yet.
CORS_ALLOWED_ORIGINS=
JWT_ISSUER=
JWT_LEEWAY_SECONDS=5

# Google/Apple Sign-In -- see docs/adr/0005-jwt-refresh-token-auth.md and
# System Architecture section 8. Only the OAuth client ID is needed (a
# public identifier, not a secret): ID tokens are verified against the
# provider's published JWKS, so no client secret is ever required or stored.
# Empty here: unset means every OAuth sign-in attempt is rejected
# (fail-closed), never silently accepted against a null audience.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# APPLE_OAUTH_JWKS_URL=https://appleid.apple.com/auth/keys
# OAUTH_JWKS_CACHE_TTL_SECONDS=3600

<?xml version="1.0" encoding="UTF-8"?>
<!--
    IMPORTANT (Docker): docker-compose.yml's app service uses
    "env_file: ./backend/.env", which Docker injects as real OS-level
    environment variables ($_SERVER) before PHP starts. Laravel's env()
    resolution checks $_SERVER before the values PHPUnit sets here via
    putenv()/$_ENV, so force="true" below is NOT sufficient on its own to
    override them when running inside this project's Docker container.
    Run tests with explicit -e overrides, e.g.:

    docker compose run [remove-after-flag] -e APP_ENV=testing -e CACHE_STORE=array       -e DB_DATABASE=aesthetic_coach_test -e QUEUE_CONNECTION=sync       -e SESSION_DRIVER=array -e BCRYPT_ROUNDS=4 -e MAIL_MAILER=array       app php artisan test

    force="true" is kept below for correctness in non-Docker (bare-metal
    PHP) test runs, where $_SERVER isn't pre-populated this way.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- Real MySQL, not SQLite in memory: see docs/10-testing-strategy.md section 5 -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="mysql" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="aesthetic_coach_test" force="true"/>
        <env name="DB_USERNAME" value="root" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
